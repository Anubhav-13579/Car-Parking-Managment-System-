{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start OS Dashboard Server",
      "type": "shell",
      "command": "node",
      "args": ["server.js"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      }
    },
    {
      "label": "Build C Simulation (POSIX / GCC)",
      "type": "shell",
      "command": "make",
      "args": ["all"],
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "Run Concurrency Tests (C)",
      "type": "shell",
      "command": "make",
      "args": ["test"],
      "problemMatcher": ["$gcc"],
      "group": "test"
    }
  ]
}
